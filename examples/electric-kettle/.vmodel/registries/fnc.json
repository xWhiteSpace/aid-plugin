      "done_beep"
    ],
    "rule": "When water_temp_c >= 100 turn heater off"
  },
  "FNC-KTL-003": {
    "id": "FNC-KTL-003",
    "kind": "FNC",
    "project": "KTL",
    "title": "Boil-dry cut-off",
    "statement": "Cut heat when element overheats without water.",
    "version": 1,
    "status": "published",
    "created_at": "2026-10-16T00:00:00+09:00",
    "updated_at": "2026-10-16T00:00:00+09:00",
    "proposed_by": "functional-specs",
    "inputs": [
      "element_temp_c"
    ],
    "outputs": [
      "heater_off",
      "fault_led"
    ],
    "rule": "When element_temp_c > 140 turn heater off and latch fault"
