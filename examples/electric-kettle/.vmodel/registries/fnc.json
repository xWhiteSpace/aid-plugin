  "FNC-KTL-002": {
    "id": "FNC-KTL-002",
    "kind": "FNC",
    "project": "KTL",
    "title": "Detect boil and stop",
    "statement": "Stop heating at boil temperature.",
    "version": 1,
    "status": "published",
    "created_at": "2026-10-16T00:00:00+09:00",
    "updated_at": "2026-10-16T00:00:00+09:00",
